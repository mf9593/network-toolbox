<?xml version="1.0" encoding="utf-8"?>
<!-- 网络概览：当前网络、关键指标、信号、详情与快捷工具 -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_margin"
            android:paddingBottom="@dimen/space_6">

            <!-- 当前网络 Hero 卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wifiCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:rippleColor="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/heroContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/wifiLogo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="网络类型"
                            android:src="@drawable/ic_signal_wifi_0_bar"
                            app:tint="?attr/colorOnPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/wifiTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="正在获取网络信息"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/wifiIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="请稍候…"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/wifiSignal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:text="--"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/wifiAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="路由器后台"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 关键指标 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/metricsCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/metricGateway"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="网关"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/gatewayValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/metricDns"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DNS"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/dnsValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/metricFrequency"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="频率"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/frequencyValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/metricSpeed"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="协商速率"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/linkSpeedValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 信号曲线：仅 WiFi 时显示 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signalCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="信号强度"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Title" />

                        <TextView
                            android:id="@+id/signalCurrent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- dBm"
                            android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall" />

                    </LinearLayout>

                    <com.networktool.app.view.SignalStrengthView
                        android:id="@+id/signalChart"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/space_2" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 网络详情 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/networkInfoCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="网络详情"
                        android:textAppearance="@style/TextAppearance.NetworkTool.Title" />

                    <LinearLayout
                        android:id="@+id/detailContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 快捷工具 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quickToolsCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷工具"
                        android:textAppearance="@style/TextAppearance.NetworkTool.Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/quickPing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:id="@+id/quickPingIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Ping"
                                android:src="@drawable/ic_ping" />

                            <TextView
                                android:id="@+id/quickPingText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Ping"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickDns"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:id="@+id/quickDnsIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="DNS"
                                android:src="@drawable/ic_dns" />

                            <TextView
                                android:id="@+id/quickDnsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="DNS"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickSpeed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:id="@+id/quickSpeedIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="测速"
                                android:src="@drawable/ic_speed" />

                            <TextView
                                android:id="@+id/quickSpeedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="测速"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickPort"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:id="@+id/quickPortIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="端口扫描"
                                android:src="@drawable/ic_port_scan" />

                            <TextView
                                android:id="@+id/quickPortText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="端口"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickMac"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:id="@+id/quickMacIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="MAC 查询"
                                android:src="@drawable/ic_mac" />

                            <TextView
                                android:id="@+id/quickMacText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="MAC"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 硬件信息：电池电量/电压/充电功率/温度 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/batteryCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/card_padding"
                        android:paddingTop="@dimen/card_padding"
                        android:text="硬件信息"
                        android:textAppearance="@style/TextAppearance.NetworkTool.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电池电量"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryPercent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电压"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryVoltage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="充电功率"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryPower"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电池温度"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryTemperature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="下拉刷新网络信息"
                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
