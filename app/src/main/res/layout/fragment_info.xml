<?xml version="1.0" encoding="utf-8"?>
<!-- 网络概览：当前网络、关键指标、信号、详情与快捷工具 -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_margin"
            android:paddingBottom="@dimen/space_6">

            <!-- 顶部标题行：名称 + 副标题 + 关于 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_1"
                android:paddingBottom="@dimen/space_3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="网络工具箱"
                        android:textAppearance="@style/TextAppearance.NetworkTool.Title"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="网络概览"
                        android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/homeMore"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="关于"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_about"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 当前网络 Hero 卡片：小标题 + 网络类型 + 运营商/IP + 状态胶囊 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wifiCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:rippleColor="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/heroContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/wifiLogo"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="网络类型"
                            android:src="@drawable/ic_signal_wifi_0_bar"
                            app:tint="?attr/colorOnPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.75"
                                android:text="当前网络"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/wifiTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="正在获取网络信息"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="21sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/wifiIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.85"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="请稍候…"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 状态胶囊：WiFi 下显示信号强度，有线/移动显示连接状态；下面显示频段 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/wifiSignal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="--"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/wifiFrequency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="--"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/wifiAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:alpha="0.72"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="路由器后台"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 三格关键指标：延迟 / 速率 / 设备（三个独立小卡片） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statLatency"
                    style="@style/Widget.NetworkTool.Card.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="延迟"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        <TextView
                            android:id="@+id/statLatencyValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Metric"
                            android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="@dimen/space_2"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statSpeed"
                    style="@style/Widget.NetworkTool.Card.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="速率"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        <TextView
                            android:id="@+id/statSpeedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Metric"
                            android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="@dimen/space_2"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statDevices"
                    style="@style/Widget.NetworkTool.Card.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                        <TextView
                            android:id="@+id/statDevicesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Metric"
                            android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 局域网设备：展示上次扫描结果的前 3 条，点「全部」进入设备页 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_1">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="局域网设备"
                    android:textAppearance="@style/TextAppearance.NetworkTool.Label" />

                <TextView
                    android:id="@+id/homeDeviceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/space_1"
                    android:text="全部"
                    android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeDeviceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical" />

            <!-- 信号曲线：仅 WiFi 时显示 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signalCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="信号强度"
                            android:textAppearance="@style/TextAppearance.NetworkTool.Title" />

                        <TextView
                            android:id="@+id/signalCurrent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- dBm"
                            android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall" />

                    </LinearLayout>

                    <com.networktool.app.view.SignalStrengthView
                        android:id="@+id/signalChart"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/space_2" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 网络详情 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/networkInfoCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="网络详情"
                        android:textAppearance="@style/TextAppearance.NetworkTool.Title" />

                    <LinearLayout
                        android:id="@+id/detailContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 硬件信息：电池电量/电压/充电功率/温度 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/batteryCard"
                style="@style/Widget.NetworkTool.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/card_padding"
                        android:paddingTop="@dimen/card_padding"
                        android:text="硬件信息"
                        android:textAppearance="@style/TextAppearance.NetworkTool.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电池电量"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryPercent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电压"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryVoltage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="充电功率"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryPower"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/metric_height"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电池温度"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

                            <TextView
                                android:id="@+id/batteryTemperature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.NetworkTool.Metric" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="下拉刷新网络信息"
                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
