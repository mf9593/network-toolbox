<?xml version="1.0" encoding="utf-8"?>
<!-- 主页「局域网设备」单张小卡片：图标 + 名称 + IP/来源 + 在线圆点 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.NetworkTool.Card.Small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/homeDeviceIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="设备图标"
            android:src="@drawable/ic_computer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeDeviceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="设备名称"
                android:textAppearance="@style/TextAppearance.NetworkTool.Body"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeDeviceSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="192.168.1.1 · 在线"
                android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeDeviceDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:text="●"
            android:textSize="9sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
