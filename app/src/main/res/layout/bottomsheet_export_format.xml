<?xml version="1.0" encoding="utf-8"?>
<!-- 导出格式选择底部弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_4">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:text="选择导出格式"
        android:textAppearance="@style/TextAppearance.NetworkTool.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="导出文件会保存到你选择的目录"
        android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/formatEncrypted"
        style="@style/Widget.NetworkTool.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="start|center_vertical"
        android:text="JSON 格式（加密）"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/formatPlain"
        style="@style/Widget.NetworkTool.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="start|center_vertical"
        android:text="JSON 格式（明文）"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/formatTxt"
        style="@style/Widget.NetworkTool.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="start|center_vertical"
        android:text="TXT 文本格式"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelFormatButton"
        style="@style/Widget.NetworkTool.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_2"
        android:text="取消"
        android:textSize="14sp" />
</LinearLayout>
