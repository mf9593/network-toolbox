<?xml version="1.0" encoding="utf-8"?>
<!-- Onvif调试布局 - 包含设备发现和RTSP预览 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:title="ONVIF调试"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIconTint="?attr/colorOnSurface" />

    <!-- Tab切换 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备发现" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTSP预览" />

    </com.google.android.material.tabs.TabLayout>

    <!-- RTSP手动输入区域 -->
    <LinearLayout
        android:id="@+id/rtspInputLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="RTSP地址"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rtspUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:text="rtsp://admin:123456@192.168.1.100:554/stream1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="设备名称（可选）"
            android:layout_marginTop="4dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/deviceNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 传输协议选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="传输协议:"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface" />

            <RadioGroup
                android:id="@+id/transportProtocolGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="8dp">

                <RadioButton
                    android:id="@+id/protocolTcp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TCP"
                    android:textSize="10sp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/protocolUdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UDP"
                    android:textSize="10sp" />

                <RadioButton
                    android:id="@+id/protocolUdpMulticast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UDP组播"
                    android:textSize="10sp" />

                <RadioButton
                    android:id="@+id/protocolHttp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HTTP"
                    android:textSize="10sp" />

            </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/rtspPlayButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="播放"
                android:textSize="12sp" />

            <Button
                android:id="@+id/rtspStopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="停止"
                android:textSize="12sp"
                style="@style/Widget.NetworkTool.Button.TonalButton" />

        </LinearLayout>

        <!-- RTSP播放器容器 -->
        <FrameLayout
            android:id="@+id/rtspPlayerContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:visibility="gone">

            <!-- 视频视图 -->
            <FrameLayout
                android:id="@+id/videoViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 顶部控制栏 -->
            <LinearLayout
                android:id="@+id/rtspTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#CC000000"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/rtspBackButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_back_white"
                    android:contentDescription="返回" />

                <TextView
                    android:id="@+id/rtspTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="RTSP预览"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/rtspFullscreenBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fullscreen"
                    android:contentDescription="全屏" />

            </LinearLayout>

            <!-- 底部控制栏 -->
            <LinearLayout
                android:id="@+id/rtspBottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#CC000000"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <!-- 进度条 -->
                <SeekBar
                    android:id="@+id/rtspSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:progressTint="#00DAC5"
                    android:thumbTint="#00DAC5" />

                <!-- 控制按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 播放/暂停 -->
                    <ImageView
                        android:id="@+id/rtspPlayPauseBtn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_play"
                        android:contentDescription="播放/暂停"
                        android:padding="4dp" />

                    <!-- 状态文本 -->
                    <TextView
                        android:id="@+id/rtspStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="准备播放"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- 分辨率 -->
                    <TextView
                        android:id="@+id/rtspResolutionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="未知"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 加载指示器 -->
            <ProgressBar
                android:id="@+id/rtspLoadingProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- 状态覆盖层 -->
            <TextView
                android:id="@+id/rtspStatusOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#CC000000"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Onvif设备列表区域 -->
    <LinearLayout
        android:id="@+id/onvifDeviceLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 工具栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Onvif设备发现"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 个设备"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/scanButton"
                style="@style/Widget.NetworkTool.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="扫描设备"
                android:textSize="12sp" />

            <Button
                android:id="@+id/addManualButton"
                style="@style/Widget.NetworkTool.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="手动添加"
                android:textSize="12sp" />

            <Button
                android:id="@+id/clearButton"
                style="@style/Widget.NetworkTool.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline" />

        <!-- 扫描进度 -->
        <ProgressBar
            android:id="@+id/scanProgressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:visibility="gone" />

        <!-- 扫描状态 -->
        <TextView
            android:id="@+id/scanStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="点击扫描设备开始搜索局域网内的Onvif摄像头"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:visibility="visible" />

        <!-- 设备列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp" />

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_videocam"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="暂未发现Onvif设备"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="确保设备和摄像头在同一局域网内"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
