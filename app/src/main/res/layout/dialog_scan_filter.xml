<?xml version="1.0" encoding="utf-8"?>
<!-- 协议筛选底部弹窗：一行一个协议，带用途说明，比一堆无名 chip 更容易选 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_4">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:id="@+id/filterSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:text="筛选协议"
        android:textAppearance="@style/TextAppearance.NetworkTool.Headline" />

    <TextView
        android:id="@+id/filterSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_1"
        android:layout_marginEnd="@dimen/space_4"
        android:text="只显示通过指定方式发现的设备"
        android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filterOptionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
