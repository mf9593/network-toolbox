<?xml version="1.0" encoding="utf-8"?>
<!-- RTSP播放器Activity布局 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 输入界面 -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTSP预览"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="输入RTSP地址进行预览"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:layout_marginBottom="48dp" />

        <!-- RTSP地址输入框 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rtspUrlEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="rtsp://..."
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 传输协议选择 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="传输协议"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/protocolGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/protocolAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="自动"
                android:checked="true"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/protocolTcp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TCP"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/protocolUdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UDP"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/protocolUdpMulticast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UDP组播"
                android:textSize="12sp" />

        </RadioGroup>

        <!-- 播放按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="开始播放"
            android:textSize="16sp"
            app:cornerRadius="28dp" />

        <!-- 提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="支持从Onvif设备自动跳转播放"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- 播放容器 -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- 视频播放器视图（按比例居中播放） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <com.networktool.app.player.RtspPlayerView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- 顶部控制栏 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#CC000000"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- 返回按钮 -->
            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back_white"
                android:contentDescription="返回"
                android:padding="6dp" />

            <!-- 标题 -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="RTSP预览"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

        <!-- 底部控制栏 -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- 状态信息 -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="准备中..."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 控制按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 播放/暂停按钮 -->
                <ImageView
                    android:id="@+id/playPauseBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_play"
                    android:contentDescription="播放/暂停"
                    android:padding="8dp" />

                <!-- 分辨率显示 -->
                <TextView
                    android:id="@+id/resolutionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="未知分辨率"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
                    
                <!-- 通道名称显示 -->
                <TextView
                    android:id="@+id/channelNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="通道1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <!-- 占位 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- 全屏按钮（右下角） -->
                <ImageView
                    android:id="@+id/fullscreenBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_fullscreen"
                    android:contentDescription="全屏"
                    android:padding="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
