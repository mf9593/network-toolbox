<?xml version="1.0" encoding="utf-8"?>
<!-- WiFi：当前连接、扫描、频段/标准下拉筛选与网络列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 标题栏：和设备搜索页保持同一套排布（主标题+按钮同行，副标题独占一行） -->
    <LinearLayout
        android:id="@+id/currentWifiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wifiTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_1"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="无线列表"
                android:textAppearance="@style/TextAppearance.NetworkTool.PageTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanEntryButton"
                style="@style/Widget.NetworkTool.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="扫一扫"
                android:minWidth="44dp"
                android:padding="10dp"
                app:icon="@drawable/ic_scan_qr"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/standardFilterButton"
                style="@style/Widget.NetworkTool.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="标准筛选"
                android:minWidth="44dp"
                android:padding="10dp"
                app:icon="@drawable/ic_tune"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanButton"
                style="@style/Widget.NetworkTool.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="重新扫描"
                android:minWidth="44dp"
                android:padding="10dp"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openWifiSettingsButton"
                style="@style/Widget.NetworkTool.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="系统无线设置"
                android:minWidth="44dp"
                android:padding="10dp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/currentIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="正在读取无线网络信息…"
            android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall" />

        <TextView
            android:id="@+id/wifiSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="正在扫描…"
            android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:text="频段"
                android:textAppearance="@style/TextAppearance.NetworkTool.Caption" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/bandChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipBandAll"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBandAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="全部" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBand24"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.4 GHz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBand5"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 GHz" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBand6"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 GHz" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </HorizontalScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/scanProgress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginEnd="@dimen/page_margin"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_2"
                android:paddingTop="@dimen/space_1"
                android:paddingEnd="@dimen/space_2"
                android:paddingBottom="@dimen/space_4" />

            <LinearLayout
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_6"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/emptyIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="未发现 WiFi"
                    android:src="@drawable/ic_empty"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:text="未发现 WiFi 网络"
                    android:textAppearance="@style/TextAppearance.NetworkTool.Title" />

                <TextView
                    android:id="@+id/emptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center"
                    android:text="请确认 WiFi 已开启并授予附近设备权限"
                    android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyAction"
                    style="@style/Widget.NetworkTool.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="重新扫描" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
