<?xml version="1.0" encoding="utf-8"?>
<!-- 设置行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/card_padding"
    android:paddingBottom="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconContainer"
        style="@style/Widget.NetworkTool.Card.Small"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:cardCornerRadius="10dp">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="设置图标"
            android:src="@drawable/ic_settings" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="设置项"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="当前值"
            android:textAppearance="@style/TextAppearance.NetworkTool.Caption"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/endIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/space_2"
        android:contentDescription="进入"
        android:src="@drawable/ic_arrow_forward"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
