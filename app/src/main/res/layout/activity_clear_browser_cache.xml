<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface">

    <!-- 标题栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:background="@android:color/transparent"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        app:title="清理浏览器缓存"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIconTint="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 说明卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清理浏览器缓存"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除 WebView 缓存可以解决网页显示异常、加载缓慢等问题。此操作不会影响已保存的密码和书签。"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 缓存选项 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/optionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择要清除的内容"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="12dp" />

                    <CheckBox
                        android:id="@+id/cbCache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="网页缓存（HTML、图片、视频等）"
                        android:textSize="14sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbCookies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cookies（网站登录状态）"
                        android:textSize="14sp"
                        android:checked="false" />

                    <CheckBox
                        android:id="@+id/cbDomStorage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DOM Storage（网站本地数据）"
                        android:textSize="14sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbFormData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="表单数据（自动填充数据）"
                        android:textSize="14sp"
                        android:checked="false" />

                    <CheckBox
                        android:id="@+id/cbPasswords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="已保存的密码"
                        android:textSize="14sp"
                        android:checked="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 缓存大小显示 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cacheSizeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前缓存大小"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvCacheSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="计算中..."
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击下方按钮清理选中的缓存"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 清理按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="清理选中的缓存"
                android:textSize="16sp"
                android:padding="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
