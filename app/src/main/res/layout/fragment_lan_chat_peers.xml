<?xml version="1.0" encoding="utf-8"?>
<!-- 好友列表页面布局（QQ风格） -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 搜索栏 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            style="@style/Widget.NetworkTool.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginBottom="@dimen/space_2"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:hint="搜索用户名、IP或UID..."
                    android:background="@null"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 排序选项栏 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.NetworkTool.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginBottom="@dimen/space_1"
            app:cardElevation="0dp"
            android:visibility="gone"
            android:id="@+id/sortCardView">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/sortChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSortOnline"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="在线优先"
                        android:checked="true"
                        android:textSize="13sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSortName"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="按名称"
                        android:textSize="13sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSortIp"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="按IP"
                        android:textSize="13sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterRoom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="仅房间"
                        android:textSize="13sp" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

        </com.google.android.material.card.MaterialCardView>

        <!-- 好友列表 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/peerRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 空状态提示 -->
            <LinearLayout
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/emptyIcon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_empty"
                    android:alpha="0.5"
                    android:contentDescription="无好友" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="暂无好友"
                    android:textSize="16sp"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="确保你和好友在同一房间"
                    android:textSize="12sp"
                    android:textColor="?android:textColorTertiary" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
