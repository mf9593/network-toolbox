<?xml version="1.0" encoding="utf-8"?>
<!-- 排序方式底部弹窗：与协议筛选弹窗同一套版式 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_4">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:text="排序方式"
        android:textAppearance="@style/TextAppearance.NetworkTool.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_1"
        android:layout_marginEnd="@dimen/space_4"
        android:text="切换后立即生效，下次打开仍然保留"
        android:textAppearance="@style/TextAppearance.NetworkTool.BodySmall" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sortOptionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
